# SeeYou — inventaire des variables d'environnement
#
# ⚠️ Ce fichier est de la DOCUMENTATION, pas une source de configuration.
# Le projet ne lit plus de fichier .env : la source de vérité est Infisical.
#
#   infisical login
#   infisical secrets --env=dev --path=/          # lister
#   infisical secrets set MA_VAR="valeur" --env=dev --path=/
#
# Lancer avec injection :
#   infisical run --env=dev --path=/ -- cargo run -p server --manifest-path backend/Cargo.toml
#   infisical run --env=dev --path=/ -- npm run dev        # depuis frontend/
#   ./scripts/dev-tmux.sh --docker                          # stack complète, injection incluse

# --- Backend ---
SERVER_HOST=0.0.0.0
SERVER_PORT=3001
REDIS_URL=redis://127.0.0.1:6379
DATABASE_URL=postgres://seeyou:seeyou_dev@127.0.0.1:5432/seeyou
# SurrealDB HTTP endpoint (ws://.../rpc is auto-normalized for backward compatibility)
SURREALDB_URL=http://127.0.0.1:8000
SURREALDB_NAMESPACE=seeyou
SURREALDB_DATABASE=graph
SURREALDB_USERNAME=root
SURREALDB_PASSWORD=root
# Primary broker endpoint (legacy-compatible with REDPANDA_URL)
REDPANDA_BROKERS=127.0.0.1:19092
REDPANDA_URL=127.0.0.1:19092
SCHEMA_REGISTRY_URL=http://127.0.0.1:18081
BUS_ENABLED=false
BUS_FALLBACK_MODE=redis_postgres
TOMTOM_API_KEY=<dans Infisical>

# --- Frontend (préfixe VITE_ pour exposition Vite) ---
VITE_WS_URL=ws://localhost:3001/ws
VITE_API_URL=http://localhost:3001
VITE_CESIUM_ION_TOKEN=<dans Infisical>
VITE_OPENWEATHER_API_KEY=<dans Infisical>
VITE_WAQI_TOKEN=<dans Infisical>
